# Set your own password (at least 8 characters); no default password exists.
ADMIN_PASSWORD=
# Optional independent random session signing secret.
ADMIN_SESSION_SECRET=
# Required only to unlock the imported bank history. Value is in local .env.local.
HISTORY_IMPORT_KEY=
PORT=3000
# On Railway attach a persistent volume at /data, then set:
# ORDERS_FILE=/data/orders.json
